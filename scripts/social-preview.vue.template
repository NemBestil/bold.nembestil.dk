<script setup lang="ts">
// Copy to app/pages/__social-preview.vue for a local 1200 × 630 capture; remove before building.
const stage = ref<HTMLElement>();
let animation = 0;
let dispose: (() => void) | undefined;
let stopped = false;
onMounted(async () => {
  const [{ SceneManager }, { DEFAULT_SETTINGS }] = await Promise.all([
    import('../../game/rendering/SceneManager'), import('../../shared/types'),
  ]);
  if (stopped) return;
  const view = new SceneManager(stage.value!);
  dispose = () => view.dispose();
  view.settings({ ...DEFAULT_SETTINGS, graphics: 'high' });
  view.camera.fov = 40;
  view.camera.position.set(3.3, 3.6, 3.6);
  view.camera.lookAt(0, 0.05, 0);
  view.camera.updateProjectionMatrix();
  const camera = view.captureCamera();
  view.table.ball.position.set(-0.18, 0.04, 0.16);
  view.table.rods.forEach((rod, index) => { rod.rotation.z = index % 2 ? -.2 : .12; });
  const render = () => {
    if (stopped) return;
    view.render(1 / 60, 'playing', undefined, camera);
    animation = requestAnimationFrame(render);
  };
  render();
});
onBeforeUnmount(() => { stopped = true; cancelAnimationFrame(animation); dispose?.(); });
</script>
<template>
  <main class="social-art">
    <img src="/branding/nembestil-bold.svg" class="social-logo" alt="Nem Bold" />
    <div class="social-copy">
      <p class="social-eyebrow">DIT EGET FODBOLDBORD.</p>
      <h1>Tag kampen<br /><em>til bordet.</em></h1>
      <p class="social-description">Spil alene. Invitér vennerne.</p>
    </div>
    <div ref="stage" class="social-table" />
    <footer><span>GRATIS · 1–4 SPILLERE · INGEN KONTO</span><span>bold.nembestil.dk</span></footer>
  </main>
</template>
